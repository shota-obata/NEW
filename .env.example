# Growth OS Mobile — 環境変数のひな形
#
# このファイルはコミットします（値は入っていません）。
# 実際の値は .env に入れてください。.gitignore で除外済みです。
#
#   cp .env.example .env
#
# ⚠ .env と、下の SUPABASE_SERVICE_ROLE_KEY / SUPABASE_DB_PASSWORD は
#   チャットに貼らないでください。画面共有にも出さないでください。

# ── クライアントに埋め込まれる値（公開前提。秘密ではない）─────────────
# anon key は RLS を前提に「公開してよい」設計のキーです。ブラウザの
# バンドルに入るため隠せません。安全性は RLS が担保します。
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── サーバ側だけで使う値（秘密）───────────────────────────────
# service_role は RLS を丸ごとバイパスします。クライアントに絶対に置かない。
# Edge Function で必要になったときは、Supabase の
#   Dashboard → Edge Functions → Secrets
# に直接入れてください。このファイルにもリポジトリにも置きません。
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI で migration を流すときだけ使う（Database → Settings のパスワード）
SUPABASE_DB_PASSWORD=

# ── ストレージ ──────────────────────────────────────────
STORAGE_BUCKET=practice-images
STORAGE_QUOTA_BYTES=1073741824
