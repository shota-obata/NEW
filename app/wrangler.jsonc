{
  // Cloudflare Workers（静的アセット）として配信する設定。
  // これが無いと Worker は「何を返せばいいか」を知らず
  // 「There is nothing here yet」のままになる。
  //
  // ダッシュボード側の設定（Settings → Build）:
  //   Root directory   app
  //   Build command    npm run build
  //   Deploy command   npx wrangler deploy
  "name": "ai-re-growth",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./dist",
    // 画面遷移は React が持つのでサーバ側のルートは無い。
    // どのパスでも index.html を返す（SPA）。
    //
    // ⚠ これと同じことを public/_redirects の `/* /index.html 200` で
    //    書いてはいけない。Workers はそれを自己ループと判定して
    //    デプロイを拒否する（code 100324）。SPA の面倒はここだけで見る。
    "not_found_handling": "single-page-application"
  }
}
